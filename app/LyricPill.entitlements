<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks outgoing Apple events unless this is granted;
	     LyricPill reads the track and position from Spotify via AppleScript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
